<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <!-- Loader-/Spiel-Assemblies liegen zur Laufzeit schon vor: nicht ins Output kopieren. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- BepInEx-Kern -->
  <ItemGroup>
    <Reference Include="0Harmony"                 HintPath="$(BepInExCoreDir)\0Harmony.dll"                 Private="false" />
    <Reference Include="BepInEx.Core"             HintPath="$(BepInExCoreDir)\BepInEx.Core.dll"             Private="false" />
    <Reference Include="BepInEx.Unity.IL2CPP"     HintPath="$(BepInExCoreDir)\BepInEx.Unity.IL2CPP.dll"     Private="false" />
    <Reference Include="Il2CppInterop.Runtime"    HintPath="$(BepInExCoreDir)\Il2CppInterop.Runtime.dll"    Private="false" />
    <Reference Include="Il2CppInterop.Common"     HintPath="$(BepInExCoreDir)\Il2CppInterop.Common.dll"     Private="false" />
  </ItemGroup>

  <!-- Von Il2CppInterop generierte Spiel-/Unity-Assemblies -->
  <ItemGroup>
    <Reference Include="Il2Cppmscorlib"                     HintPath="$(InteropDir)\Il2Cppmscorlib.dll"                     Private="false" />
    <Reference Include="Assembly-CSharp"                    HintPath="$(InteropDir)\Assembly-CSharp.dll"                    Private="false" />
    <Reference Include="UnityEngine.CoreModule"             HintPath="$(InteropDir)\UnityEngine.CoreModule.dll"             Private="false" />
    <Reference Include="UnityEngine.PhysicsModule"          HintPath="$(InteropDir)\UnityEngine.PhysicsModule.dll"          Private="false" />
    <Reference Include="UnityEngine.IMGUIModule"            HintPath="$(InteropDir)\UnityEngine.IMGUIModule.dll"            Private="false" />
    <Reference Include="UnityEngine.TextRenderingModule"    HintPath="$(InteropDir)\UnityEngine.TextRenderingModule.dll"    Private="false" />
    <Reference Include="UnityEngine.InputLegacyModule"      HintPath="$(InteropDir)\UnityEngine.InputLegacyModule.dll"      Private="false" />
    <Reference Include="UnityEngine.UI"                     HintPath="$(InteropDir)\UnityEngine.UI.dll"                     Private="false" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="PostBuildEvent" Condition="'$(DeployToGame)' == 'true'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PluginsDir)" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\data\GwyfAimbot_Cache.json" DestinationFolder="$(PluginsDir)" Condition="Exists('$(MSBuildThisFileDirectory)..\data\GwyfAimbot_Cache.json')" />
    <Copy SourceFiles="$(MSBuildThisFileDirectory)..\data\GwyfAimbot_Cache.json" DestinationFolder="$(ConfigDir)\GwyfAimbotMod" Condition="Exists('$(MSBuildThisFileDirectory)..\data\GwyfAimbot_Cache.json')" />
    <Message Importance="high" Text="Deployed -> $(PluginsDir)\$(TargetFileName) and Knowledge Base Cache" />
  </Target>

</Project>
